<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Travel Cost Calculator"/>
        <attribute name="authors" value="lenovo"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-17 11:36:21 AM"/>
        <attribute name="created" value="bGVub3ZvO0RBRkZJTkU7MjAyNi0wOS0xNzswODowMjoxNSBBTTsyNDI0"/>
        <attribute name="edited" value="bGVub3ZvO0RBRkZJTkU7MjAyNi0wOS0xNzsxMTozNjoyMSBBTTs2OzI1MzU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="jarak, efisiensi, harga, totalJarak, konsumsi, biaya" type="Real" array="False" size=""/>
            <declare name="jenis" type="Integer" array="False" size=""/>
            <declare name="ulang" type="String" array="False" size=""/>
            <output expression="&quot;Masukkan jarak perjalanan (km): &quot;" newline="True"/>
            <input variable="jarak"/>
            <output expression="&quot;Masukkan efisiensi kendaraan (km/liter): &quot;" newline="True"/>
            <input variable="efisiensi"/>
            <output expression="&quot;Masukkan harga BBM per liter: &quot;" newline="True"/>
            <input variable="harga"/>
            <output expression="&quot;1 = Sekali Jalan, 2 = Pulang-Pergi&quot;" newline="True"/>
            <input variable="jenis"/>
            <if expression="jenis = 2">
                <then>
                    <assign variable="totalJarak" expression="jarak*2"/>
                </then>
                <else>
                    <assign variable="totalJarak" expression="jarak"/>
                </else>
            </if>
            <assign variable="konsumsi" expression="totalJarak / efisiensi"/>
            <assign variable="biaya" expression="konsumsi*harga"/>
            <output expression="&quot;totalJarak perjalanan = &quot; &amp; totalJarak &amp; &quot; km&quot;" newline="True"/>
            <output expression="&quot;Estimasi konsumsi BBM = &quot; &amp; konsumsi &amp; &quot; liter&quot;" newline="True"/>
            <output expression="&quot;Estimasi biaya BBM = Rp &quot; &amp; biaya" newline="True"/>
            <output expression="&quot;Hitung perjalanan lain? (ya/tidak): &quot;" newline="True"/>
            <input variable="ulang"/>
        </body>
    </function>
</flowgorithm>
